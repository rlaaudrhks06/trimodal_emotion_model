.venv/
__pycache__/
*.pyc
data/raw/
data/processed_full/
data/processed/
data/feature_cache/
data/manifests/*.csv
# 화자독립 분할(manifests_si) 등 파생 매니페스트 — split_manifest.py + 시드로 재현 가능
data/manifests_*/*.csv
data/*.json
checkpoints/
checkpoints_periodic/
*.pt
*.log
archived_runs/
.DS_Store

# 단, 임베딩 덤프는 예외의 예외 — 발화 11,464개 × 512차원 × 4종이라
# .npz 약 90MB, Projector용 .tsv 약 50MB다. GitHub 파일당 한도가 100MB이고
# extract_embeddings.py로 체크포인트에서 언제든 다시 뽑을 수 있으므로 넣지 않는다.
results/embeddings/

# results/ 는 예외 — 의도적으로 공유하는 산출물만 여기에 둔다:
#   results/csv_summary/ : 학습 곡선(에폭별 지표) CSV
#   results/eval/        : 평가 결과 JSON (test accuracy/F1/혼동행렬 + 재현에 필요한 config·checkpoint 경로)
# 체크포인트(.pt)는 개당 약 488MB라 git에 넣지 않는다 — 서버 archived_runs/에만 보관하고,
# 위 두 디렉터리가 "그 체크포인트로 무엇을 얻었는지"의 기록 역할을 한다.

# safetensors 변환본 (1.2GB) — convert_to_safetensors.py로 재생성 가능
models/

# 문서 PDF는 md에서 재생성한다(scripts/build_docs_pdf.py) — 통합기록만 6.7MB라
# 갱신할 때마다 커밋하면 저장소가 금방 무거워진다. md와 assets/만 추적한다.
docs/*.pdf
docs/*.html
